# .versionbot.yml — PR Version Bot configuration
# All fields are optional. Workflow inputs override these values.
# Remove this file entirely to use built-in defaults.

# File paths
versionFile: VERSION.md
changelogFile: CHANGELOG.md

# Version bump behaviour
defaultBump: patch
tagPrefix: v

# Release options
createGithubRelease: true
failOnMultipleLabels: true
dryRun: false
targetBranch: main
commitMessageTemplate: 'chore(release): {tag}'
syncPackageJson: false
useConventionalCommits: false
# usePrTemplateLabels: false

# Notifications (optional — store URLs in GitHub secrets, not here)
# slackWebhookUrl: ''
# discordWebhookUrl: ''
# notificationTemplate: '🚀 Released {tag}: {prTitle} (#{prNumber})'

# Monorepo support (optional)
# packages:
#   - packages/api
#   - packages/web

# Custom label names (optional — defaults shown)
labels:
  major: release:major
  minor: release:minor
  patch: release:patch
  none: release:none
  alpha: release:alpha
  beta: release:beta
  rc: release:rc
