{
  "name": "pr-version-bot",
  "version": "0.0.0",
  "description": "Reusable GitHub Action for automatic semantic versioning from merged pull requests",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^9.1.1",
    "js-yaml": "^4.2.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
